  "documentTypes": [
    {
      "id": "PDS_CONTRACT",
      "title": "Договор ПДС",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractDate",
          "contractNumber",
          "snils"
        ],
        "properties": {
          "contractDate": {
            "type": "string",
            "title": "Дата договора",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "format": "date",
            "minLength": 1
          },
          "contractNumber": {
            "type": "string",
            "title": "Номер договора",
            "minLength": 1,
            "maxLength": 64
          },
          "snils": {
            "type": "string",
            "title": "СНИЛС",
            "pattern": "^\\d{3}-\\d{3}-\\d{3} \\d{2}$",
            "minLength": 1
          }
        }
      },
      "ui": {
        "columns": [
          "contractDate",
          "contractNumber",
          "snils"
        ],
        "fields": [
