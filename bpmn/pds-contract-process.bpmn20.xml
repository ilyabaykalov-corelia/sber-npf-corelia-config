<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
        xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
        xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
        xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
        xmlns:flowable="http://flowable.org/bpmn"
        id="Definitions_pds_contract_process"
        targetNamespace="http://corelia.ru/bpmn">

    <bpmn:process id="pds_contract_process" name="Проверка документа" isExecutable="true">
        <bpmn:startEvent id="StartEvent_1" name="Start">
            <bpmn:outgoing>Flow_Start_To_Timer</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:intermediateCatchEvent id="Timer_WaitForCheck" name="Ожидание">
            <bpmn:incoming>Flow_Start_To_Timer</bpmn:incoming>
            <bpmn:outgoing>Flow_Timer_To_Check</bpmn:outgoing>
            <bpmn:timerEventDefinition>
                <bpmn:timeDuration>PT45S</bpmn:timeDuration>
            </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>

        <bpmn:userTask id="UserTask_CheckDocument" name="Проверка документа" flowable:candidateGroups="app_owner">
            <bpmn:incoming>Flow_Timer_To_Check</bpmn:incoming>
            <bpmn:outgoing>Flow_Check_To_End</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:endEvent id="EndEvent_1" name="End">
            <bpmn:incoming>Flow_Check_To_End</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow
                id="Flow_Start_To_Timer"
                sourceRef="StartEvent_1"
                targetRef="Timer_WaitForCheck"/>

        <bpmn:sequenceFlow
                id="Flow_Timer_To_Check"
                sourceRef="Timer_WaitForCheck"
                targetRef="UserTask_CheckDocument"/>

        <bpmn:sequenceFlow
                id="Flow_Check_To_End"
                sourceRef="UserTask_CheckDocument"
                targetRef="EndEvent_1"/>
    </bpmn:process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_pds_contract_process">
        <bpmndi:BPMNPlane id="BPMNPlane_pds_contract_process" bpmnElement="pds_contract_process">

            <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
                <dc:Bounds x="150" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="UserTask_CheckDocument_di" bpmnElement="UserTask_CheckDocument">
                <dc:Bounds x="260" y="80" width="160" height="80"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
                <dc:Bounds x="500" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNEdge id="Flow_Start_To_Check_di" bpmnElement="Flow_Start_To_Check">
                <di:waypoint x="186" y="120"/>
                <di:waypoint x="260" y="120"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Flow_Check_To_End_di" bpmnElement="Flow_Check_To_End">
                <di:waypoint x="420" y="120"/>
                <di:waypoint x="500" y="120"/>
            </bpmndi:BPMNEdge>

        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>

</bpmn:definitions>
