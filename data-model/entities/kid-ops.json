{
  "id": "KID_OPS",
  "title": "КИД ОПС",
  "schemaVersion": 1,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "contractNumber",
      "contractDate",
      "signingYear",
      "lastName",
      "firstName",
      "snils"
    ],
    "properties": {
      "contractNumber": {
        "type": "string",
        "title": "Номер договора",
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^ОПС-[0-9]{3}-[0-9]{4}-[0-9]{7}$"
      },
      "contractDate": {
        "type": "string",
        "title": "Дата договора",
        "maxLength": 10,
        "minLength": 1,
        "format": "date"
      },
      "signingYear": {
        "type": "integer",
        "title": "Год подписания",
        "min": 2010,
        "max": 2200
      },
      "lastName": {
        "type": "string",
        "title": "Фамилия",
        "maxLength": 40,
        "minLength": 1
      },
      "firstName": {
        "type": "string",
        "title": "Имя",
        "maxLength": 255,
        "minLength": 1
      },
      "middleName": {
        "type": "string",
        "title": "Отчество",
        "maxLength": 256,
        "minLength": 0
      },
      "snils": {
        "type": "string",
        "title": "СНИЛС",
        "maxLength": 14,
        "minLength": 1,
        "pattern": "^[0-9]{3}-[0-9]{3}-[0-9]{3} [0-9]{2}$"
      }
    }
  },
  "storage": {
    "provider": "platform-v",
    "entity": "KidOps",
    "details": "kidOps",
    "fields": {
      "contractNumber": "contractNumber",
      "contractDate": "contractDate",
      "signingYear": "signingYear",
      "lastName": "lastName",
      "firstName": "firstName",
      "middleName": "middleName",
      "snils": "snils"
    },
    "operations": {
      "search": "searchDocument",
      "create": "createKidOps",
      "update": "commitKidOpsAttributes"
    }
  },
  "workflow": {
    "processes": {
      "create": "Process_kid_ops_storage"
    },
    "actions": {
      "CREATE": "create"
    },
    "creationAction": "CREATE",
    "creationSource": "configuration",
  "externalFields": [
    "contractNumber",
    "snils"
  ],
    "completion": {
      "statusField": "status",
      "assigneeField": "assignee",
      "assignmentStatuses": [
        "IN_WORK"
      ],
      "assignmentCodes": [
        "взять в работу",
        "take_on"
      ],
      "autoStart": true
    },
    "terminalStatuses": [
      "STORED"
    ]
  },
  "attachments": {
    "enabled": true,
    "initialRequired": true,
    "maxCount": 2147483647
  },
  "presentation": {
    "statuses": {
      "CREATED": "Создан",
      "IN_WORK": "В работе",
      "STORED": "На хранении"
    },
    "aliases": {},
    "tones": {
      "CREATED": "info",
      "IN_WORK": "info",
      "STORED": "success"
    },
    "initialStatus": "CREATED"
  },
  "normalization": {
    "contractNumber": {
      "trim": true
    },
    "contractDate": {
      "trim": true
    },
    "lastName": {
      "trim": true
    },
    "firstName": {
      "trim": true
    },
    "middleName": {
      "trim": true,
      "nullAsEmpty": true,
      "defaultEmpty": true
    },
    "snils": {
      "trim": true
    }
  }
}
