{
  "id": "PDS_CONTRACT",
  "title": "Договор ПДС",
  "schemaVersion": 1,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "contractDate",
      "contractNumber",
      "snils"
    ],
    "properties": {
      "contractDate": {
        "type": "string",
        "title": "Дата договора",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "format": "date",
        "minLength": 1
      },
      "contractNumber": {
        "type": "string",
        "title": "Номер договора",
        "minLength": 1,
        "maxLength": 64
      },
      "snils": {
        "type": "string",
        "title": "СНИЛС",
        "pattern": "^\\d{3}-\\d{3}-\\d{3} \\d{2}$",
        "minLength": 1
      }
    }
  },
  "storage": {
    "provider": "platform-v",
    "entity": "PdsContract",
    "details": "pdsContract",
    "fields": {
      "contractDate": "contractDate",
      "contractNumber": "contractNumber",
      "snils": "snils"
    },
    "operations": {
      "search": "searchDocument",
      "create": "createPdsContract",
      "update": "commitDocumentAttributes"
    }
  },
  "workflow": {
    "flowable": {
      "definitionKey": "pds_contract_process",
      "bpmn": "bpmn/pds-contract-process.bpmn20.xml",
      "tasks": {
        "UserTask_CheckDocument": {
          "actions": [
            {
              "code": "take_on",
              "label": "Взять в работу",
              "status": "IN_WORK",
              "tone": "info"
            }
          ]
        }
      }
    },
    "processes": {
      "create": "Process_pds_contract_approval"
    },
    "actions": {
      "CREATE": "create"
    },
    "creationAction": "CREATE",
    "creationSource": "configuration",
    "externalFields": [
      "contractNumber",
      "snils"
    ],
    "completion": {
      "statusField": "status",
      "assigneeField": "assignee",
      "assignmentStatuses": [
        "IN_WORK"
      ],
      "assignmentCodes": [
        "взять в работу",
        "take_on"
      ],
      "autoStart": true
    },
    "commands": {
      "takeInWork": { "from": ["CREATED", "NEEDS_REVISION"], "to": "IN_WORK" },
      "submit": { "from": ["IN_WORK"], "to": "ON_APPROVAL" },
      "approve": { "from": ["ON_APPROVAL"], "to": "APPROVED" },
      "returnForRevision": { "from": ["ON_APPROVAL"], "to": "NEEDS_REVISION" },
      "reject": { "from": ["IN_WORK", "ON_APPROVAL"], "to": "REJECTED" }
    },
    "terminalStatuses": [
      "APPROVED",
      "REJECTED"
    ]
  },
  "attachments": {
    "enabled": true,
    "initialRequired": false,
    "maxCount": 2147483647
  },
  "presentation": {
    "statuses": {
      "CREATED": "Создан",
      "IN_WORK": "В работе",
      "ON_APPROVAL": "На согласовании",
      "NEEDS_REVISION": "Отправлено на доработку",
      "APPROVED": "Согласован",
      "REJECTED": "Отклонен"
    },
    "aliases": {
      "на доработке": "NEEDS_REVISION",
      "отклонён": "REJECTED"
    },
    "tones": {
      "CREATED": "info",
      "IN_WORK": "info",
      "ON_APPROVAL": "warning",
      "NEEDS_REVISION": "warning",
      "APPROVED": "success",
      "REJECTED": "error"
    },
    "initialStatus": "CREATED"
  },
  "normalization": {
    "contractDate": {
      "trim": true
    },
    "contractNumber": {
      "trim": true
    },
    "snils": {
      "trim": true
    }
  }
}
